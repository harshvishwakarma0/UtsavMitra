rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin';
    }

    function isEventMember(eventId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        (
          request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.memberUids ||
          request.auth.uid == get(/databases/$(database)/documents/events/$(eventId)).data.createdBy
        );
    }

    function isEventOwner(eventId) {
      return isEventMember(eventId) && (
        get(/databases/$(database)/documents/events/$(eventId)).data.createdBy == request.auth.uid ||
        isSuperAdmin()
      );
    }

    function isReasonableSize() {
      return request.resource == null || request.resource.data.keys().size() < 50;
    }

    // Users: super admin full; users read/update own doc only.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSuperAdmin() || (request.auth.uid == uid && !exists(/databases/$(database)/documents/users/$(uid)));
      allow update: if isSuperAdmin() || (request.auth.uid == uid);
      allow delete: if isSuperAdmin();
    }

    // Events: members read; owner or super admin write.
    match /events/{eventId} {
      allow read: if isEventMember(eventId) || isSuperAdmin();
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberUids.hasAll([request.auth.uid]) &&
        isReasonableSize()
      );
      allow update: if isEventOwner(eventId) || isSuperAdmin() || (
        // Allow any signed-in user to add themselves to an event (self-join via invite)
        isSignedIn() &&
        // The update must include the requesting user in memberUids
        request.resource.data.memberUids.hasAny([request.auth.uid]) &&
        // Can only add members, not remove (size must increase or stay same)
        request.resource.data.memberUids.size() >= resource.data.memberUids.size() &&
        // Safety: max 10 members per event
        request.resource.data.memberUids.size() <= 10 &&
        // User can only modify member-related fields
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids', 'pendingMemberEmails'])
      );
      allow delete: if isEventOwner(eventId) || isSuperAdmin();

      match /{subcollection}/{docId} {
        allow read: if isEventMember(eventId) || isSuperAdmin();
        allow create, update: if (isEventMember(eventId) || isSuperAdmin()) && isReasonableSize();
        allow delete: if isEventMember(eventId) || isSuperAdmin();
      }
    }

    // Event Invites: owners create, user reads their own by email, user claims their own
    match /eventInvites/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.email == request.auth.token.email ||
        isEventOwner(resource.data.eventId) || isSuperAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.email is string &&
        request.resource.data.status == "pending";
      allow update: if isSignedIn() && (
        (resource.data.email == request.auth.token.email && request.resource.data.status == "claimed") ||
        isEventOwner(resource.data.eventId) || isSuperAdmin()
      );
      allow delete: if isEventOwner(resource.data.eventId) || isSuperAdmin();
    }

    // Shared templates: all signed-in read; creator writes own; super admin manages all.
    match /templates/{tid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isReasonableSize();
      allow update, delete: if isSuperAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Meta: app-level state (first user marker, etc.)
    match /_meta/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
